# Copier ce fichier en .env.local pour le developpement local (jamais commite).
# Toutes ces valeurs sont PUBLIQUES par nature : elles finissent dans le bundle JS livre au
# navigateur. Ne jamais y mettre une cle service_role ou un secret Supabase.

# URL du projet Supabase (Project Settings > API)
VITE_SUPABASE_URL=

# Cle publique "anon" / "publishable" (Project Settings > API) -- PAS la service_role key
VITE_SUPABASE_PUBLISHABLE_KEY=

# Adresse e-mail du compte administrateur unique. Ce n'est pas un secret : c'est juste
# l'identifiant utilise par le formulaire de connexion admin avec signInWithPassword().
VITE_ADMIN_EMAIL=

# Chemin de base pour le deploiement GitHub Pages, ex: /pcm-experimental/ pour un depot
# "pcm-experimental" deploye sur https://<user>.github.io/pcm-experimental/.
# Laisser vide (ou "/") pour le developpement local.
VITE_APP_BASE_PATH=/
